{
  "name": "@with-jiko/next-logger-logtape",
  "version": "1.1.4",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/jiko-packages.git",
    "directory": "packages/next-logger-logtape"
  },
  "bugs": {
    "url": "https://github.com/semyonshap/jiko-packages/issues"
  },
  "keywords": [
    "next",
    "nextjs",
    "logging",
    "logtape",
    "json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --logLevel warn",
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:integrations": "vitest run tests/integrations"
  },
  "peerDependencies": {
    "@logtape/logtape": "^2.0.0",
    "next": ">=13.1.0"
  },
  "devDependencies": {
    "@logtape/logtape": "^2.0.0",
    "@types/node": "^20",
    "next": "^16.3.2",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@edge-runtime/format": "^4.0.0",
    "ansi-regex": "^6.2.2"
  }
}
