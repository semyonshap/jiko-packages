{
  "name": "@with-jiko/config",
  "version": "0.1.0",
  "description": "JSON/ENV config loading helpers for apps.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/jiko-packages.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/semyonshap/jiko-packages/issues"
  },
  "keywords": [
    "config",
    "env",
    "dotenv",
    "zod",
    "json"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --logLevel warn",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix .",
    "knip": "knip",
    "clean": "rimraf dist .tsdown"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "rimraf": "^6.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  }
}
